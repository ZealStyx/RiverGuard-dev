# Copy the frontend values to apps/web/.env.local for local development.
# `npm run convex:dev` creates these values after you select a development
# deployment. Do not commit the generated .env.local file.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Firebase Authentication -----------------------------------------------
# Public web-app configuration for Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# --- Local ML service (services/ml) -----------------------------------------
# Where the Next route handler finds the inference service.
ML_API_BASE_URL=http://127.0.0.1:8000
# Model artifact, relative to the repository root unless absolute.
# ML_MODEL_PATH=ml/artifacts/model.json
# ML_MAX_FORECAST_DAYS=14
# ML_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Weather provider -------------------------------------------------------
# open-meteo (default, no key) or fixture (offline, clearly labelled).
# The provider is the model's only input source: one call supplies past_days=30
# (today's rain, antecedent 3/7/30-day sums, soil moisture) plus forecast_days=7.
# data/daily_observations.csv is history for the charts, not a model input.
WEATHER_PROVIDER=open-meteo
# Set to false to fail loudly instead of substituting illustrative numbers when
# the provider is unreachable. Keep the default for demos, set false for anything
# someone might mistake for a real forecast.
WEATHER_ALLOW_FIXTURE=false

# --- Local run store --------------------------------------------------------
# Only used when NEXT_PUBLIC_CONVEX_URL is not set: completed runs are appended
# to this file so run history, run detail and run comparison have something to
# read. Default is <repo>/.data/runs.json (gitignored).
# RUN_STORE_PATH=.data/runs.json

# --- Map basemap ------------------------------------------------------------
# Raster tile template and the credit the map must display. The default is the
# OpenStreetMap Standard layer from the volunteer-run tile.openstreetmap.org,
# used under https://operations.osmfoundation.org/policies/tiles/ : attribution
# stays visible, tiles are cached by the browser, nothing is prefetched, and
# only the current viewport is requested. Bulk, offline, or public-scale use is
# not allowed on that server — point these at another provider (and set its
# attribution) or self-host tiles instead.
# Provider preset: osm (default) or carto. OSM answers "403 Access blocked" to
# origins it considers unidentifiable — shared or cloud preview origins often
# are — so switch to carto (or a custom URL) when the map reports a block.
# NEXT_PUBLIC_MAP_TILE_PROVIDER=carto
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --- Verified local GIS layers ----------------------------------------------
# RiverGuard ships no GIS geometry. Overlays appear only for layers that
# `npm run gis:verify` accepted from data/gis/manifest.json; nothing is fetched
# from a GIS service at runtime. Point this elsewhere only to test verification
# against a scratch directory.
# GIS_DATA_DIR=data/gis

# Optional invitation email notifications. Configure these on the Convex
# deployment. Without them invitations are delivered in-app only.
# RESEND_API_KEY=
# RIVERGUARD_INVITE_FROM=
# RIVERGUARD_APP_URL=
