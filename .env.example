# Copy the frontend values to apps/web/.env.local for local development.
# `npm run convex:dev` creates these values after you select a development
# deployment. Do not commit the generated .env.local file.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Local ML service (services/ml) -----------------------------------------
# Where the Next route handler finds the inference service.
ML_API_BASE_URL=http://127.0.0.1:8000
# Model artifact, relative to the repository root unless absolute.
# ML_MODEL_PATH=ml/artifacts/model.json
# ML_MAX_FORECAST_DAYS=14
# ML_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Weather provider -------------------------------------------------------
# open-meteo (default, no key) or fixture (offline, clearly labelled).
WEATHER_PROVIDER=open-meteo
# Set to false to fail loudly instead of substituting illustrative numbers when
# the provider is unreachable. Keep the default for demos, set false for anything
# someone might mistake for a real forecast.
WEATHER_ALLOW_FIXTURE=false
