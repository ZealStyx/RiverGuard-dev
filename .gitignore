.DS_Store
Thumbs.db

# GIS geometry is licence-bound and usually large: keep it local, keep the
# manifest and README in git. `npm run gis:verify` is what makes a file drawable.
data/gis/*.geojson
data/gis/*.topojson
data/gis/*.gpkg
data/gis/*.shp
data/gis/*.shx
data/gis/*.dbf
data/gis/*.prj
data/gis/*.kml
